[Unit]
Description=Create a consistent eNet API SQLite backup

[Service]
Type=oneshot
User=enet-api
Group=enet-api
EnvironmentFile=/etc/enet-api/enet-api.env
Environment=ENET_BACKUP_DIR=/var/backups/enet-api
ExecStart=/opt/enet-app/api/deploy/backup-enet-db.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/enet-api
